---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <h1>{title}</h1>
      <slot />
    </main>
    <style is:global>
      body {
        font-family: system-ui, sans-serif;
        line-height: 1.5;
        margin: 0;
      }
      main {
        max-width: 40rem;
        margin: 0 auto;
        padding: 1rem;
      }
      .card {
        border: 1px solid #8884;
        border-radius: 0.5rem;
        padding: 0 1rem;
        margin-block: 1rem;
      }
      .spacer {
        min-height: 150vh;
      }
    </style>
  </body>
</html>
